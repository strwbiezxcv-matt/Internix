# ---- InternConnect configuration ----

# The port the server listens on.
PORT=3000

# A random secret used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Where the SQLite database file is stored (relative to the project root).
DB_PATH=./data/internconnect.db

# Optional. If set to 1, the database is re-seeded with sample data on startup.
SEED_DEMO_DATA=1